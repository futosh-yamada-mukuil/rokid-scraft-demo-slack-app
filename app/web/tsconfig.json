{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // TypeScript 7 は noUncheckedSideEffectImports が既定 true なので、
    // main.tsx の `import "./style.css"` に型宣言が要る。
    // vite/client が *.css などの Vite 固有モジュールを宣言している。
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts"]
}
