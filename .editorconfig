root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
# Jetpack Compose の @Composable 関数は PascalCase のため function-naming の対象から除外する。
ktlint_function_naming_ignore_when_annotated_with = Composable
# Compose の慣習に合わせ、命名系の厳格ルールは緩める。
ktlint_standard_function-naming = disabled

[*.{yml,yaml,json,xml}]
indent_size = 2
