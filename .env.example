# 音声認識（AmiVoice）
AMIVOICE_API_KEY=

# PCモニター側の翻訳・音声認識（Gemini）。Android翻訳には使わない。
GEMINI_API_KEY=

# 読み上げ（Google Cloud Text-to-Speech）
GOOGLE_TTS_API_KEY=

# Microsoft Graph（Teams）
MS_TENANT_ID=
MS_CLIENT_ID=
MS_TEAM_ID=
MS_CHANNEL_ID=

DEV_UPLOAD_URL=
# Android: shared key for Google Speech-to-Text, Text-to-Speech and Cloud Translation Basic.
# Enable all three APIs and billing. Keep the real value only in ignored .env.
GOOGLE_STT_TTS_TRANSLATE_API_KEY=

# Slack: BotトークンはPC中継サーバだけが使用します。APKには入れません。
# specs/slack-app-manifest.json をMUKUiLにインストールし、Botを開発用プライベートチャンネルへ追加。
SLACK_BOT_TOKEN=
SLACK_WORKSPACE_ID=
SLACK_CHANNEL_ID=
# 実機はHTTPSの中継サーバURL。AVDのslackEmulatorは127.0.0.1:8787 + adb reverseを使用。
SLACK_RELAY_URL=
